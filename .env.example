# Example .env file for the IDEB Checking Application
# Copy this file to `.env` and adjust the values as needed.

# Path to the input JSON file used for internal search mockup
INPUT_JSON_PATH=memory-bank/input.json

# Path to the SQLite database file
DB_PATH=ideb.db

# Port on which the Go server will listen
SERVER_PORT=8080

# API Key for Gemini (if used for any features, though not currently implemented in core logic)
# GEMINI_API_KEY=your_actual_gemini_api_key_here